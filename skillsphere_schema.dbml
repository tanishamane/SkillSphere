  Checks {
    `((proficiency_level)::text = ANY ((ARRAY['Unaware'::character varying, 'Beginner'::character varying, 'Intermediate'::character varying, 'Advanced'::character varying, 'Expert'::character varying])::text[]))` [name: 'employee_skills_proficiency_level_check']
  }

  Indexes {
    (user_id, skill_id) [unique, name: "uq_user_skill"]
  }
}

