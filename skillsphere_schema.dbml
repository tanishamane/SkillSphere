  "created_at" timestamp [not null, default: `now()`]
  "updated_at" timestamp [not null, default: `now()`]
  "preferred_format" "character varying(30)" [default: `'VIRTUAL'::charactervarying`]
  "bio" text

  Checks {
    `(max_mentees > 0)` [name: 'mentor_profiles_max_mentees_check']
  }

  Indexes {
    is_active [type: btree, name: "idx_mentor_profiles_active"]
    user_id [type: btree, name: "idx_mentor_profiles_user"]
  }
}

Table "mentorship_feedback" {
  "id" bigint [pk, not null]
  "session_id" bigint [unique, not null]
  "author_id" bigint [not null]
  "rating" integer [not null]
  "comments" text [not null]
  "created_at" timestamp [not null, default: `now()`]

  Checks {
    `((rating >= 1) AND (rating <= 5))` [name: 'mentorship_feedback_rating_check']
  }

  Indexes {
    author_id [type: btree, name: "idx_feedback_author"]
  }
}

Table "mentorship_goals" {
  "id" bigint [pk, not null]
  "assignment_id" bigint [not null]
  "title" "character varying(140)" [not null]
  "description" text
  "target_date" date
  "status" "character varying(20)" [not null, default: `'IN_PROGRESS'::charactervarying`]
  "created_at" timestamp [not null, default: `now()`]
  "updated_at" timestamp [not null, default: `now()`]
  "priority" "character varying(20)" [default: `'MEDIUM'::charactervarying`]
  "skill_id" bigint

  Checks {
    `((status)::text = ANY ((ARRAY['PROPOSED'::character varying, 'AGREED'::character varying, 'IN_PROGRESS'::character varying, 'ACHIEVED'::character varying, 'COMPLETED'::character varying, 'ON_HOLD'::character varying, 'ABANDONED'::character varying, 'CANCELLED'::character varying])::text[]))` [name: 'mentorship_goals_status_check']
  }

  Indexes {
    assignment_id [type: btree, name: "idx_goals_assignment"]
  }
}

Table "mentorship_requests" {
  "id" bigint [pk, not null]
  "mentor_id" bigint [not null]
  "employee_id" bigint [not null]
  "message" text
  "status" "character varying(20)" [not null, default: `'PENDING'::charactervarying`]
  "created_at" timestamp [not null, default: `now()`]
  "responded_at" timestamp
  "response_note" text

  Checks {
    `((status)::text = ANY ((ARRAY['PENDING'::character varying, 'ACCEPTED'::character varying, 'DECLINED'::character varying, 'CANCELLED'::character varying])::text[]))` [name: 'mentorship_requests_status_check']
  }

  Indexes {
    employee_id [type: btree, name: "idx_mentorship_requests_employee"]
    mentor_id [type: btree, name: "idx_mentorship_requests_mentor"]
  }
}

Table "mentorship_sessions" {
  "id" bigint [pk, not null]
  "assignment_id" bigint [not null]
  "title" "character varying(140)" [not null]
  "description" text
  "scheduled_at" timestamp [not null]
  "duration_minutes" integer [not null, default: 45]
  "meeting_link" "character varying(500)"
  "status" "character varying(20)" [not null, default: `'SCHEDULED'::charactervarying`]
  "created_at" timestamp [not null, default: `now()`]
  "updated_at" timestamp [not null, default: `now()`]
  "shared_notes" text
  "mentor_prep_notes" text

  Checks {
    `(duration_minutes > 0)` [name: 'mentorship_sessions_duration_minutes_check']
    `((status)::text = ANY ((ARRAY['SCHEDULED'::character varying, 'COMPLETED'::character varying, 'CANCELLED'::character varying])::text[]))` [name: 'mentorship_sessions_status_check']
  }

  Indexes {
    assignment_id [type: btree, name: "idx_sessions_assignment"]
    scheduled_at [type: btree, name: "idx_sessions_scheduled"]
  }
}

Table "message_reports" {
  "id" bigint [pk, not null]
  "message_id" bigint [not null]
  "reporter_id" bigint [not null]
  "reason" "character varying(255)" [not null]
  "details" text
  "status" "character varying(30)" [not null, default: `'PENDING'::charactervarying`]
  "created_at" timestamp [not null, default: `now()`]

  Indexes {
    (message_id, reporter_id) [unique, name: "uq_msg_report"]
    status [type: btree, name: "idx_msg_reports_status"]
  }
}

Table "messages" {
  "id" bigint [pk, not null]
  "conversation_id" bigint [not null]
  "sender_id" bigint [not null]
  "content" text [not null]
  "attachment_url" "character varying(500)"
  "attachment_name" "character varying(140)"
  "created_at" timestamp [not null, default: `now()`]

  Indexes {
    conversation_id [type: btree, name: "idx_messages_conversation"]
    created_at [type: btree, name: "idx_messages_created"]
  }
}

Table "notifications" {
  "id" bigint [pk, not null]
  "recipient_id" bigint [not null]
  "type" "character varying(30)" [not null]
  "title" "character varying(140)" [not null]
  "message" text [not null]
  "link" "character varying(250)"
  "is_read" boolean [not null, default: false]
  "created_at" timestamp [not null, default: `now()`]

  Indexes {
    recipient_id [type: btree, name: "idx_notifications_recipient"]
  }
}

Table "password_reset_tokens" {
  "id" bigint [pk, not null]
  "user_id" bigint [not null]
  "token_hash" "character varying(64)" [unique, not null]
  "expires_at" timestamp [not null]
  "used_at" timestamp
  "created_at" timestamp [not null, default: `now()`]

  Indexes {
    user_id [type: btree, name: "idx_prt_user"]
  }
}

Table "platform_feedback" {
  "id" bigint [pk, not null]
  "user_id" bigint
  "category" "character varying(80)" [not null]
  "rating" integer [not null]
  "comments" text [not null]
  "created_at" timestamp [not null, default: `now()`]

  Checks {
    `((rating >= 1) AND (rating <= 5))` [name: 'platform_feedback_rating_check']
  }
}

Table "reassessment_requests" {
  "id" bigint [pk, not null]
  "manager_id" bigint [not null]
  "employee_id" bigint [not null]
  "skill_id" bigint [not null]
  "reason" text [not null]
  "status" "character varying(20)" [not null, default: `'PENDING'::charactervarying`]
  "created_at" timestamp [not null, default: `now()`]
  "updated_at" timestamp [not null, default: `now()`]

  Checks {
    `((status)::text = ANY ((ARRAY['PENDING'::character varying, 'COMPLETED'::character varying, 'CANCELLED'::character varying])::text[]))` [name: 'chk_reassessment_status']
  }

  Indexes {
    employee_id [type: btree, name: "idx_reassessment_employee"]
    manager_id [type: btree, name: "idx_reassessment_manager"]
  }
}

Table "role_skill_requirements" {
  "id" bigint [pk, not null]
  "job_role" "character varying(80)" [not null]
  "skill_id" bigint [not null]
  "required_proficiency" "character varying(20)" [not null]
  "priority" "character varying(20)" [not null, default: `'HIGH'::charactervarying`]
  "created_at" timestamp [not null, default: `now()`]
  "is_active" boolean [not null, default: true]

  Checks {
    `((priority)::text = ANY ((ARRAY['HIGH'::character varying, 'MEDIUM'::character varying, 'LOW'::character varying])::text[]))` [name: 'role_skill_requirements_priority_check']
    `((required_proficiency)::text = ANY ((ARRAY['Unaware'::character varying, 'Beginner'::character varying, 'Intermediate'::character varying, 'Advanced'::character varying, 'Expert'::character varying])::text[]))` [name: 'role_skill_requirements_required_proficiency_check']
  }

  Indexes {
    (job_role, skill_id) [unique, name: "uq_role_skill"]
  }
}

Table "shared_resources" {
  "id" bigint [pk, not null]
