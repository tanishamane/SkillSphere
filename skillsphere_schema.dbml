Table "assessment_assignments" {
  "id" bigint [pk, not null]
  "assessment_id" bigint [not null]
  "user_id" bigint [not null]
  "assigned_by_id" bigint [not null]
  "due_date" date
  "status" "character varying(20)" [not null, default: `'PENDING'::charactervarying`]
  "created_at" timestamp [not null, default: `now()`]

  Checks {
    `((status)::text = ANY ((ARRAY['PENDING'::character varying, 'COMPLETED'::character varying, 'OVERDUE'::character varying])::text[]))` [name: 'assessment_assignments_status_check']
  }
}

Table "assessment_attempts" {
  "id" bigint [pk, not null]
  "user_id" bigint [not null]
  "skill_id" bigint [not null]
  "assessment_id" bigint
  "assignment_id" bigint
  "target_level" "character varying(30)" [not null, default: `'Intermediate'::charactervarying`]
  "current_level" "character varying(30)" [default: `'Unaware'::charactervarying`]
  "status" "character varying(20)" [not null, default: `'IN_PROGRESS'::charactervarying`]
  "generation_source" "character varying(30)" [not null, default: `'FALLBACK'::charactervarying`]
  "generation_status" "character varying(30)" [not null, default: `'SUCCESS'::charactervarying`]
  "generation_error" text
  "score" integer
  "passed" boolean
  "correct_answers" integer
  "total_questions" integer [not null, default: 0]
  "answers_json" text
  "started_at" timestamp [not null, default: `now()`]
  "completed_at" timestamp

  Checks {
    `((generation_source)::text = ANY ((ARRAY['AI_GENERATED'::character varying, 'FALLBACK'::character varying])::text[]))` [name: 'assessment_attempts_generation_source_check']
    `((generation_status)::text = ANY ((ARRAY['SUCCESS'::character varying, 'FALLBACK_TRIGGERED'::character varying, 'FAILED'::character varying])::text[]))` [name: 'assessment_attempts_generation_status_check']
    `((status)::text = ANY ((ARRAY['IN_PROGRESS'::character varying, 'COMPLETED'::character varying, 'ABANDONED'::character varying, 'EXPIRED'::character varying])::text[]))` [name: 'assessment_attempts_status_check']
  }

  Indexes {
    skill_id [type: btree, name: "idx_assessment_attempts_skill"]
    user_id [type: btree, name: "idx_assessment_attempts_user"]
    (user_id, skill_id, started_at [desc]) [type: btree, name: "idx_assessment_attempts_user_skill"]
    (user_id, status) [type: btree, name: "idx_assessment_attempts_user_status"]
  }
}

Table "assessment_questions" {
  "id" bigint [pk, not null]
  "assessment_id" bigint [not null]
  "skill_id" bigint [not null]
  "question_text" text [not null]
  "options_json" text [not null]
  "correct_answer_index" integer [not null]
  "points" integer [not null, default: 1]
  "attempt_id" bigint
  "difficulty" "character varying(20)" [not null, default: `'MEDIUM'::charactervarying`]
  "subtopic" "character varying(100)"
  "explanation" text
  "question_order" integer [not null, default: 0]

  Indexes {
    attempt_id [type: btree, name: "idx_assessment_questions_attempt"]
    (skill_id, difficulty) [type: btree, name: "idx_assessment_questions_skill_diff"]
  }
}

Table "assessment_responses" {
  "id" bigint [pk, not null]
  "submission_id" bigint [not null]
  "question_id" bigint [not null]
  "selected_option_index" integer [not null]
  "is_correct" boolean [not null]
}

Table "assessment_submissions" {
  "id" bigint [pk, not null]
  "assessment_id" bigint [not null]
  "user_id" bigint [not null]
  "assignment_id" bigint
  "score" integer [not null]
  "passed" boolean [not null, default: false]
  "completed_at" timestamp [not null, default: `now()`]
  "attempt_id" bigint
  "generation_source" "character varying(30)" [not null, default: `'FALLBACK'::charactervarying`]
  "target_level" "character varying(30)"
  "skill_id" bigint
}

Table "audit_logs" {
  "id" bigint [pk, not null]
  "user_id" bigint
  "action" "character varying(100)" [not null]
  "entity_name" "character varying(100)" [not null]
  "entity_id" "character varying(100)"
  "details" text
  "ip_address" "character varying(45)"
  "created_at" timestamp [not null, default: `now()`]
}

Table "calendar_events" {
  "id" bigint [pk, not null]
  "creator_id" bigint [not null]
  "title" "character varying(140)" [not null]
  "description" text
  "event_type" "character varying(20)" [not null]
  "start_time" timestamp [not null]
  "end_time" timestamp [not null]
  "location_or_link" "character varying(500)"
  "reference_id" bigint
  "created_at" timestamp [not null, default: `now()`]

  Checks {
    `((event_type)::text = ANY ((ARRAY['ASSESSMENT'::character varying, 'MENTORSHIP'::character varying, 'LEARNING'::character varying, 'TRAINING'::character varying, 'TEAM'::character varying])::text[]))` [name: 'calendar_events_event_type_check']
  }
}

Table "certificates" {
  "id" bigint [pk, not null]
  "user_id" bigint [not null]
  "course_id" bigint [not null]
  "certificate_code" "character varying(80)" [unique, not null]
  "title" "character varying(140)" [not null]
  "issue_date" date [not null, default: `CURRENT_DATE`]
  "expiry_date" date
  "credential_url" "character varying(500)"
  "created_at" timestamp [not null, default: `now()`]
}

Table "conversation_participants" {
  "id" bigint [pk, not null]
  "conversation_id" bigint [not null]
  "user_id" bigint [not null]
  "joined_at" timestamp [not null, default: `now()`]
  "last_read_at" timestamp
  "is_muted" boolean [not null, default: false]
  "is_archived" boolean [not null, default: false]

  Indexes {
    (conversation_id, user_id) [unique, name: "uq_conv_user"]
  }
}

Table "conversations" {
  "id" bigint [pk, not null]
  "type" "character varying(20)" [not null, default: `'DIRECT'::charactervarying`]
  "title" "character varying(140)"
  "created_at" timestamp [not null, default: `now()`]
  "updated_at" timestamp [not null, default: `now()`]
  "team_id" bigint

  Checks {
    `((type)::text = ANY ((ARRAY['DIRECT'::character varying, 'TEAM'::character varying])::text[]))` [name: 'conversations_type_check']
  }

  Indexes {
    team_id [type: btree, name: "idx_conversations_team"]
  }
}

Table "courses" {
  "id" bigint [pk, not null]
  "title" "character varying(140)" [not null]
  "description" text
  "skill_id" bigint
  "level" "character varying(20)" [not null]
  "duration_hours" integer [not null, default: 10]
  "provider" "character varying(80)" [not null, default: `'SkillSphere Academy'::charactervarying`]
  "course_url" "character varying(500)"
  "thumbnail_url" "character varying(500)"
  "created_at" timestamp [not null, default: `now()`]
  "is_active" boolean [not null, default: true]

  Checks {
    `((level)::text = ANY ((ARRAY['Beginner'::character varying, 'Intermediate'::character varying, 'Advanced'::character varying])::text[]))` [name: 'courses_level_check']
  }
}

Table "departments" {
  "id" bigint [pk, not null]
  "name" "character varying(100)" [unique, not null]
  "code" "character varying(20)" [unique, not null]
  "description" text
  "head_user_id" bigint
  "created_at" timestamp [not null, default: `now()`]
}

Table "discussion_replies" {
  "id" bigint [pk, not null]
  "thread_id" bigint [not null]
  "author_id" bigint [not null]
  "content" text [not null]
  "is_accepted_answer" boolean [not null, default: false]
  "created_at" timestamp [not null, default: `now()`]
}

Table "discussion_threads" {
  "id" bigint [pk, not null]
  "author_id" bigint [not null]
  "title" "character varying(140)" [not null]
  "content" text [not null]
  "category" "character varying(80)"
  "created_at" timestamp [not null, default: `now()`]
  "updated_at" timestamp [not null, default: `now()`]
  "reply_count" integer [not null, default: 0]
}

Table "employee_learning" {
  "id" bigint [pk, not null]
  "user_id" bigint [not null]
  "course_id" bigint [not null]
  "status" "character varying(30)" [not null, default: `'NOT_STARTED'::charactervarying`]
  "progress_pct" integer [not null, default: 0]
  "enrolled_at" timestamp [not null, default: `now()`]
  "completed_at" timestamp
  "expires_at" timestamp

  Checks {
    `((status)::text = ANY ((ARRAY['NOT_STARTED'::character varying, 'IN_PROGRESS'::character varying, 'COMPLETED'::character varying, 'CERTIFIED'::character varying, 'EXPIRED'::character varying])::text[]))` [name: 'employee_learning_status_check']
  }

  Indexes {
    (user_id, course_id) [unique, name: "uq_user_course"]
  }
}

Table "employee_profiles" {
  "id" bigint [pk, not null]
  "user_id" bigint [unique, not null]
  "job_role" "character varying(80)" [not null, default: `'Software Developer'::charactervarying`]
  "department" "character varying(80)"
  "experience_level" "character varying(40)" [not null, default: `'Entry level'::charactervarying`]
  "bio" text
  "skills" text
  "created_at" timestamp [not null, default: `now()`]
  "updated_at" timestamp [not null, default: `now()`]

  Checks {
    `((experience_level)::text = ANY ((ARRAY['Entry level'::character varying, 'Intermediate'::character varying, 'Experienced'::character varying])::text[]))` [name: 'chk_profile_experience']
    `((job_role)::text = ANY ((ARRAY['Software Developer'::character varying, 'Data Analyst'::character varying, 'QA Engineer'::character varying, 'Support Engineer'::character varying])::text[]))` [name: 'chk_profile_job_role']
  }

  Indexes {
    job_role [type: btree, name: "idx_employee_profiles_job_role"]
    user_id [type: btree, name: "idx_employee_profiles_user"]
  }
}

