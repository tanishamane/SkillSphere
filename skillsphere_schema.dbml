  "content" text [not null]
  "priority" "character varying(20)" [not null, default: `'NORMAL'::charactervarying`]
  "created_at" timestamp [not null, default: `now()`]

  Checks {
    `((priority)::text = ANY ((ARRAY['NORMAL'::character varying, 'HIGH'::character varying, 'URGENT'::character varying])::text[]))` [name: 'hr_announcements_priority_check']
    `((target_type)::text = ANY ((ARRAY['ORGANIZATION'::character varying, 'DEPARTMENT'::character varying, 'ROLE'::character varying])::text[]))` [name: 'hr_announcements_target_type_check']
  }

  Indexes {
