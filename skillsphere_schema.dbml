  "description" text
  "evidence_url" "character varying(500)"
  "status" "character varying(20)" [not null, default: `'PENDING'::charactervarying`]
  "reviewed_by_id" bigint
  "created_at" timestamp [not null, default: `now()`]

  Checks {
    `((status)::text = ANY ((ARRAY['PENDING'::character varying, 'APPROVED'::character varying, 'REJECTED'::character varying])::text[]))` [name: 'skill_evidence_status_check']
  }
}

Table "skill_gaps" {
  "id" bigint [pk, not null]
  "user_id" bigint [not null]
  "skill_id" bigint [not null]
  "current_level" integer [not null]
  "required_level" integer [not null]
  "gap_size" integer [not null]
  "priority" "character varying(20)" [not null]
  "calculated_at" timestamp [not null, default: `now()`]

  Checks {
    `((priority)::text = ANY ((ARRAY['HIGH'::character varying, 'MEDIUM'::character varying, 'LOW'::character varying, 'ON_TRACK'::character varying])::text[]))` [name: 'skill_gaps_priority_check']
  }

  Indexes {
    (user_id, skill_id) [unique, name: "uq_user_skill_gap"]
    user_id [type: btree, name: "idx_skill_gaps_user"]
  }
}

Table "skills" {
  "id" bigint [pk, not null]
  "category_id" bigint [not null]
  "name" "character varying(100)" [unique, not null]
  "description" text
  "created_at" timestamp [not null, default: `now()`]
  "is_active" boolean [not null, default: true]
}

Table "support_tickets" {
  "id" bigint [pk, not null]
  "user_id" bigint [not null]
  "subject" "character varying(140)" [not null]
  "description" text [not null]
  "priority" "character varying(20)" [not null, default: `'MEDIUM'::charactervarying`]
  "status" "character varying(20)" [not null, default: `'OPEN'::charactervarying`]
  "admin_notes" text
  "created_at" timestamp [not null, default: `now()`]
  "updated_at" timestamp [not null, default: `now()`]

  Checks {
    `((priority)::text = ANY ((ARRAY['LOW'::character varying, 'MEDIUM'::character varying, 'HIGH'::character varying])::text[]))` [name: 'support_tickets_priority_check']
    `((status)::text = ANY ((ARRAY['OPEN'::character varying, 'IN_PROGRESS'::character varying, 'RESOLVED'::character varying, 'CLOSED'::character varying])::text[]))` [name: 'support_tickets_status_check']
  }
}

