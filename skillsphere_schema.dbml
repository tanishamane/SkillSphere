  "difficulty_level" "character varying(30)" [default: `'Beginner'::charactervarying`]
}

Table "manager_course_recommendations" {
  "id" bigint [pk, not null]
  "manager_id" bigint [not null]
  "employee_id" bigint [not null]
  "course_id" bigint [not null]
  "skill_id" bigint
  "reason" text [not null]
  "status" "character varying(20)" [not null, default: `'RECOMMENDED'::charactervarying`]
  "created_at" timestamp [not null, default: `now()`]
  "updated_at" timestamp [not null, default: `now()`]

  Checks {
    `((status)::text = ANY ((ARRAY['RECOMMENDED'::character varying, 'ENROLLED'::character varying, 'DISMISSED'::character varying])::text[]))` [name: 'chk_mgr_rec_status']
  }

  Indexes {
    employee_id [type: btree, name: "idx_mgr_rec_employee"]
    manager_id [type: btree, name: "idx_mgr_rec_manager"]
  }
}

Table "mentee_skill_consents" {
  "id" bigint [pk, not null]
  "employee_id" bigint [not null]
  "mentor_id" bigint [not null]
  "can_view_skills" boolean [not null, default: true]
  "can_view_gaps" boolean [not null, default: true]
  "can_view_assessments" boolean [not null, default: true]
  "consent_status" "character varying(20)" [not null, default: `'GRANTED'::charactervarying`]
  "created_at" timestamp [not null, default: `now()`]
  "updated_at" timestamp [not null, default: `now()`]

  Checks {
    `((consent_status)::text = ANY ((ARRAY['GRANTED'::character varying, 'REVOKED'::character varying])::text[]))` [name: 'mentee_skill_consents_consent_status_check']
  }

  Indexes {
    (employee_id, mentor_id) [unique, name: "uq_mentee_mentor_consent"]
    employee_id [type: btree, name: "idx_mentee_consent_employee"]
    mentor_id [type: btree, name: "idx_mentee_consent_mentor"]
  }
}

Table "mentor_assignments" {
  "id" bigint [pk, not null]
  "mentor_id" bigint [not null]
  "employee_id" bigint [not null]
  "assigned_by_id" bigint [not null]
  "status" "character varying(20)" [not null, default: `'ACTIVE'::charactervarying`]
  "notes" text
  "assigned_at" timestamp [not null, default: `now()`]
  "ended_at" timestamp

  Checks {
    `(mentor_id <> employee_id)` [name: 'chk_no_self_mentoring']
    `((status)::text = ANY ((ARRAY['ACTIVE'::character varying, 'COMPLETED'::character varying, 'TERMINATED'::character varying])::text[]))` [name: 'mentor_assignments_status_check']
  }

  Indexes {
    employee_id [type: btree, name: "idx_mentor_assignments_employee"]
    mentor_id [type: btree, name: "idx_mentor_assignments_mentor"]
    employee_id [type: btree, unique, name: "uq_active_employee_mentor"]
  }
}

Table "mentor_availability" {
  "id" bigint [pk, not null]
  "mentor_id" bigint [not null]
  "day_of_week" "character varying(20)" [not null]
  "start_time" time [not null]
  "end_time" time [not null]
  "session_format" "character varying(30)" [not null, default: `'VIRTUAL'::charactervarying`]
  "is_available" boolean [not null, default: true]
  "created_at" timestamp [not null, default: `now()`]

  Checks {
    `(end_time > start_time)` [name: 'chk_time_window']
    `((day_of_week)::text = ANY ((ARRAY['MONDAY'::character varying, 'TUESDAY'::character varying, 'WEDNESDAY'::character varying, 'THURSDAY'::character varying, 'FRIDAY'::character varying, 'SATURDAY'::character varying, 'SUNDAY'::character varying])::text[]))` [name: 'mentor_availability_day_of_week_check']
    `((session_format)::text = ANY ((ARRAY['VIRTUAL'::character varying, 'IN_PERSON'::character varying, 'HYBRID'::character varying])::text[]))` [name: 'mentor_availability_session_format_check']
  }

  Indexes {
    mentor_id [type: btree, name: "idx_mentor_availability_mentor"]
  }
}

Table "mentor_evaluations" {
  "id" bigint [pk, not null]
  "mentor_id" bigint [not null]
  "employee_id" bigint [not null]
  "session_id" bigint
  "rating" integer [not null]
  "strengths" text
  "areas_for_growth" text
  "comments" text [not null]
  "created_at" timestamp [not null, default: `now()`]

  Checks {
    `((rating >= 1) AND (rating <= 5))` [name: 'mentor_evaluations_rating_check']
  }

  Indexes {
    employee_id [type: btree, name: "idx_mentor_evaluations_employee"]
    mentor_id [type: btree, name: "idx_mentor_evaluations_mentor"]
  }
}

Table "mentor_profiles" {
  "id" bigint [pk, not null]
  "user_id" bigint [unique, not null]
  "headline" "character varying(140)" [not null]
  "expertise_areas" text [not null]
