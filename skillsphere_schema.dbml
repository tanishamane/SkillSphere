  "department_id" bigint
  "summary_notes" text
  "report_data_json" text
  "created_at" timestamp [not null, default: `now()`]

  Checks {
    `((shared_with_role)::text = ANY ((ARRAY['MANAGER'::character varying, 'DEPARTMENT_HEAD'::character varying, 'ALL_LEADERSHIP'::character varying])::text[]))` [name: 'leadership_report_shares_shared_with_role_check']
  }

  Indexes {
