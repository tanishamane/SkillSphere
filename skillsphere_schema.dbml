  "enrolled_at" timestamp [not null, default: `now()`]

  Checks {
    `((status)::text = ANY ((ARRAY['ENROLLED'::character varying, 'ATTENDED'::character varying, 'CANCELLED'::character varying])::text[]))` [name: 'training_enrollments_status_check']
  }

  Indexes {
    (programme_id, user_id) [unique, name: "uq_programme_user"]
  }
}

Table "training_programmes" {
  "id" bigint [pk, not null]
  "title" "character varying(140)" [not null]
  "description" text
  "department_id" bigint
  "start_date" date [not null]
  "end_date" date [not null]
  "capacity" integer [not null, default: 30]
  "trainer_name" "character varying(100)"
  "status" "character varying(20)" [not null, default: `'UPCOMING'::charactervarying`]
  "created_at" timestamp [not null, default: `now()`]
  "enrolled_count" integer [not null, default: 0]
  "skill_id" bigint
  "course_id" bigint

  Checks {
    `((status)::text = ANY ((ARRAY['UPCOMING'::character varying, 'ACTIVE'::character varying, 'COMPLETED'::character varying, 'CANCELLED'::character varying])::text[]))` [name: 'training_programmes_status_check']
  }
}

Table "users" {
  "id" bigint [pk, not null]
  "full_name" "character varying(120)" [not null]
  "email" "character varying(254)" [unique, not null]
  "employee_id" "character varying(30)" [unique]
  "password_hash" "character varying(100)" [not null]
  "role" "character varying(20)" [not null, default: `'EMPLOYEE'::charactervarying`]
  "requested_role" "character varying(20)"
  "account_status" "character varying(20)" [not null, default: `'ACTIVE'::charactervarying`]
  "created_at" timestamp [not null, default: `now()`]
  "updated_at" timestamp [not null, default: `now()`]

  Checks {
    `((email)::text = lower((email)::text))` [name: 'chk_users_email_lc']
    `((requested_role IS NULL) OR ((requested_role)::text = ANY ((ARRAY['EMPLOYEE'::character varying, 'MANAGER'::character varying, 'MENTOR'::character varying, 'HR_SPECIALIST'::character varying, 'DEPARTMENT_HEAD'::character varying, 'ADMIN'::character varying])::text[])))` [name: 'chk_users_req_role']
    `((role)::text = ANY ((ARRAY['EMPLOYEE'::character varying, 'MANAGER'::character varying, 'MENTOR'::character varying, 'HR_SPECIALIST'::character varying, 'DEPARTMENT_HEAD'::character varying, 'ADMIN'::character varying])::text[]))` [name: 'chk_users_role']
    `((account_status)::text = ANY ((ARRAY['ACTIVE'::character varying, 'PENDING'::character varying, 'SUSPENDED'::character varying])::text[]))` [name: 'chk_users_status']
  }

  Indexes {
    role [type: btree, name: "idx_users_role"]
  }
}

