          ],
          "path": [
            "api",
            "auth",
            "reset-password"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"PASTE_TOKEN_FROM_BACKEND_LOG\",\n  \"password\": \"N3w!Passw0rd#\",\n  \"confirmPassword\": \"N3w!Passw0rd#\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
