        },
        "description": "Log in as the bootstrap admin first."
      }
    },
    {
      "name": "13. (Admin) Change role",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-XSRF-TOKEN",
            "value": "{{csrfToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/users/2/role",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "users",
            "2",
            "role"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"role\": \"HR\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
