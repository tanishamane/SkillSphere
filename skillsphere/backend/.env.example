# Copy to ".env" (same folder as pom.xml). The .env file is git-ignored.
# Values below are placeholders only.

DB_URL=jdbc:postgresql://localhost:5432/skillsphere_db
DB_USERNAME=postgres
DB_PASSWORD=change_me

SERVER_PORT=8080
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# true when the site is served over HTTPS
COOKIE_SECURE=false

# Development only: prints password-reset links in the backend console
LOG_RESET_LINKS=true

# Optional: creates the first Admin on startup if no Admin exists yet
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe!2024
ADMIN_FULL_NAME=SkillSphere Administrator

# Google Gemini API key for AI course recommendations.
# Create one free at https://aistudio.google.com/apikey  (never commit your real key)
GEMINI_API_KEY=
# Optional: change the model if Google retires this one
GEMINI_MODEL=gemini-3.5-flash
